{
	"name": "@chrisptang/pi-model-alias",
	"version": "0.1.0",
	"description": "Pi extension that switches the session model through short aliases and optional per-skill model overrides.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"model",
		"alias",
		"model-selection",
		"skills",
		"thinking-level"
	],
	"files": [
		"src",
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./dist/index.ts"
		]
	},
	"scripts": {
		"build": "node scripts/build-runtime.mjs",
		"check": "npm run build && biome check . && npm run typecheck",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"prepack": "npm run build"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@earendil-works/pi-coding-agent": "0.85.0",
		"@types/node": "26.4.1",
		"esbuild": "0.28.2",
		"typescript": "7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/chrisptang/pi-extensions",
		"directory": "packages/pi-model-alias"
	}
}
