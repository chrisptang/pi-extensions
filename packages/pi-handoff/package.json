{
	"name": "@chrisptang/pi-handoff",
	"version": "0.1.0",
	"description": "Start a fresh Pi session to investigate an earlier session and confirm its goal before continuing.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"session",
		"handoff",
		"context",
		"prompt"
	],
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"check": "biome check . && npm run typecheck",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@types/node": "26.4.1",
		"typescript": "7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/chrisptang/pi-extensions",
		"directory": "packages/pi-handoff"
	}
}
