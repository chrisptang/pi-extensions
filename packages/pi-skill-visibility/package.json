{
	"name": "@narumitw/pi-skill-visibility",
	"version": "0.1.0",
	"description": "Pi extension that reduces automatic skill exposure and analyzes local skill-use evidence.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"skills",
		"skill-visibility",
		"autocomplete",
		"prompt"
	],
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"check": "biome check . && npm run typecheck",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@earendil-works/pi-coding-agent": "0.85.0",
		"@earendil-works/pi-server": "0.85.0",
		"@earendil-works/pi-tui": "0.85.0",
		"@types/node": "26.4.1",
		"typescript": "7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/narumiruna/pi-extensions",
		"directory": "packages/pi-skill-visibility"
	}
}
